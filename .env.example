# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit .env ke GitHub!

# OpenWeatherMap API Key
# Daftar gratis di: https://openweathermap.org/api
NUXT_PUBLIC_WEATHER_API_KEY=your_api_key_here

# Kota default saat pertama load
NUXT_PUBLIC_DEFAULT_CITY=Surakarta

# Base URL API (tidak perlu diubah)
NUXT_PUBLIC_API_BASE_URL=https://api.openweathermap.org/data/2.5
